# {{ ansible_managed }}
# Interpolated into docker-compose.yaml by compose itself.

# What the OIDC callback URL, invitation links and exports are built from.
PENPOT_PUBLIC_URI=https://penpot.alexandre-gerault.fr

# Authelia as the only way in: the client registered in authelia_oidc_clients.
PENPOT_OIDC_CLIENT_ID=penpot
PENPOT_OIDC_CLIENT_SECRET={{ vault_penpot_oidc_client_secret }}
PENPOT_OIDC_BASE_URI=https://{{ authelia_domain }}
