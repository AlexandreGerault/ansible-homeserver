# {{ ansible_managed }}
# select a revision to deploy, available values: stable, beta, canary
AFFINE_REVISION=stable

# set the port for the server container it will expose the server on
PORT=3010

# set the host for the server for outgoing links — every link in a mail
# (invitations, sign-in, password reset) is built from it, and without it they
# point at localhost
AFFINE_SERVER_EXTERNAL_URL={{ affine_external_url }}

# position of the database data to persist
DB_DATA_LOCATION=$HOME/affine/self-host/postgres/pgdata
# position of the upload data(images, files, etc.) to persist
UPLOAD_LOCATION=$HOME/affine/self-host/storage
# position of the configuration files to persist
CONFIG_LOCATION=$HOME/.affine/self-host/config

# database credentials
DB_USERNAME=affine
DB_PASSWORD={{ vault_affine_db_password }}
DB_DATABASE=affine
{% if smtp_host | default('') | length > 0 %}

# outgoing mail, through the shared account from group_vars. nodemailer turns
# TLS on from the first byte by itself when the port is 465.
MAILER_HOST={{ smtp_host }}
MAILER_PORT={{ smtp_port }}
MAILER_USER={{ smtp_username }}
MAILER_PASSWORD='{{ vault_smtp_password }}'
MAILER_SENDER='{{ smtp_sender }}'
# the HELO name; otherwise the container id
MAILER_SERVERNAME={{ affine_external_url | urlsplit('hostname') }}
{% endif %}
