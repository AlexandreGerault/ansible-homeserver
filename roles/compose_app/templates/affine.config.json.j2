{
  "oauth": {
    "providers": {
      "oidc": {
        "clientId": "affine",
        "clientSecret": {{ vault_affine_oidc_client_secret | to_json }},
        "issuer": "https://{{ keycloak_domain }}/realms/{{ keycloak_realm }}",
        "args": {
          "scope": "openid profile email"
        }
      }
    }
  }
}
