# {{ ansible_managed }}
#
# Seed only. qBittorrent rewrites this file wholesale every time it exits, so
# Ansible writes it once and then keeps its hands off — set
# qbittorrent_reset_config=true for one run to make this template win again.
# Keys checked against qBittorrent 5.2.3.

[LegalNotice]
Accepted=true

[BitTorrent]
Session\DefaultSavePath={{ qbittorrent_downloads_mount }}/complete
Session\TempPath={{ qbittorrent_downloads_mount }}/incomplete
Session\TempPathEnabled=true
Session\Port={{ qbittorrent_torrenting_port }}
# Second line of defence behind gluetun's killswitch: bind the session to the
# tunnel device, so a dropped VPN means no peer traffic even if the firewall
# were somehow permissive. tun0 is gluetun's VPN_INTERFACE default.
Session\Interface=tun0
Session\InterfaceName=tun0

[Preferences]
WebUI\Enabled=true
WebUI\Address=*
WebUI\Port=8080
WebUI\Username={{ qbittorrent_webui_username }}
WebUI\Password_PBKDF2="{{ vault_qbittorrent_password_pbkdf2 }}"
WebUI\LocalHostAuth=true
WebUI\CSRFProtection=true
WebUI\ClickjackingProtection=true
# Caddy passes the original Host through, so validation stays on et seuls les
# noms ci-dessous sont acceptés. `gluetun` doit en faire partie : c'est le nom
# par lequel Sonarr, Radarr, Prowlarr et le widget Homepage joignent la WebUI,
# et qBittorrent compare l'en-tête Host à cette liste AVANT de regarder les
# identifiants — l'omettre répond 401 à toute la stack *arr, ce qui ressemble à
# un mauvais mot de passe.
#
# LES GUILLEMETS SONT OBLIGATOIRES, ne les retirez pas. qBittorrent sépare les
# domaines par `;` (webapplication.cpp : `getServerDomains().split(u';')`), mais
# lit le fichier avec QSettings, dont l'analyseur INI termine la ligne sur un
# `;` rencontré hors guillemets :
#
#     Q_ASSERT(ch == ';');
#     if (i == lineStart + 1) { /* commentaire de ligne */ }
#     else if (!inQuotes) { --i; goto break_out_of_outer_loop; }
#         — qtbase/src/corelib/io/qsettings.cpp, readIniLine
#
# Sans guillemets, tout ce qui suit le premier `;` est jeté à la lecture, puis
# qBittorrent réécrit le fichier amputé à sa prochaine sortie. Entre guillemets
# le `;` est conservé, et QSettings retire les guillemets à la lecture (même
# fichier, iniUnescapedStringList : `case '"': ++i;` sans les recopier).
WebUI\HostHeaderValidation=true
WebUI\ServerDomains="{{ (([qbittorrent_webui_domain] if qbittorrent_webui_domain else []) + ['gluetun']) | join(';') }}"
WebUI\HTTPS\Enabled=false
WebUI\UseUPnP=false
