# {{ ansible_managed }}
#
# qbittorrent has no network of its own: `network_mode: service:gluetun` puts it
# in gluetun's namespace, where the only route out is the tunnel. The WebUI is
# therefore published on the gluetun container, not on this one.
name: qbittorrent

networks:
  # gluetun's own bridge, where qbittorrent lives with it.
  default:
  # Shared with jellyfin and the *arr stack. gluetun joins it so Sonarr and
  # Radarr can drive the WebUI by name; qbittorrent inherits the namespace and
  # therefore the reachability, without gaining a route out of the tunnel.
  media:
    name: {{ media_network }}
    external: true

services:
  gluetun:
    image: {{ qbittorrent_gluetun_image }}
    container_name: gluetun
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      # CyberGhost is built into gluetun: it ships the server list and the
      # CyberGhost root CA, picks a host matching the filters below and resolves
      # it before raising the firewall. Nothing here needs a .ovpn file.
      VPN_SERVICE_PROVIDER: {{ qbittorrent_vpn_provider }}
      VPN_TYPE: openvpn
      OPENVPN_PROTOCOL: {{ qbittorrent_openvpn_protocol }}
{% if qbittorrent_vpn_server_countries %}
      SERVER_COUNTRIES: "{{ qbittorrent_vpn_server_countries | join(',') }}"
{% endif %}
{% if qbittorrent_vpn_server_hostnames %}
      SERVER_HOSTNAMES: "{{ qbittorrent_vpn_server_hostnames | join(',') }}"
{% endif %}
      TZ: {{ common_timezone }}
      # Without this the killswitch drops the *arr containers' traffic too:
      # gluetun's firewall only routes replies back to subnets it has been told
      # about, and the media network is not one it discovers on its own.
      FIREWALL_OUTBOUND_SUBNETS: "{{ media_network_subnet }}"
{% if qbittorrent_vpn_input_ports %}
      # Le port des pairs, ouvert en entrée sur l'interface du tunnel et là
      # seulement — pas sur le bridge docker, pas sur l'hôte. C'est ce qui
      # permet à un pair d'ouvrir la connexion plutôt que de devoir être
      # contacté en premier. Voir qbittorrent_vpn_input_ports dans les defaults
      # du rôle : tant que le fournisseur ne redirige aucun port, la règle ne
      # voit rien passer.
      FIREWALL_VPN_INPUT_PORTS: "{{ qbittorrent_vpn_input_ports | join(',') }}"
{% endif %}
    # CyberGhost wants a client certificate and key on top of the username and
    # password. gluetun reads all four from /run/secrets, and parses the two PEM
    # ones itself — hence the files hold the armour lines, not base64.
    secrets:
      - openvpn_user
      - openvpn_password
      - openvpn_clientcrt
      - openvpn_clientkey
    networks:
      - default
      - media
    ports:
      # WebUI of the container below, reachable only through Caddy.
      - "{{ docker_publish_address }}:{{ qbittorrent_webui_port }}:8080/tcp"

  qbittorrent:
    image: {{ qbittorrent_image }}
    container_name: qbittorrent
    restart: unless-stopped
    network_mode: "service:gluetun"
    depends_on:
      gluetun:
        condition: service_healthy
    environment:
      PUID: "{{ qbittorrent_account.uid }}"
      PGID: "{{ qbittorrent_media_group_state.gid }}"
      # Finished files land group-writable so Jellyfin picks them up in place.
      UMASK: "002"
      TZ: {{ common_timezone }}
      WEBUI_PORT: "8080"
      TORRENTING_PORT: "{{ qbittorrent_torrenting_port }}"
    volumes:
      - {{ qbittorrent_config_dir }}:/config
      - {{ jellyfin_media_root }}:{{ qbittorrent_media_mount }}

secrets:
  openvpn_user:
    file: {{ qbittorrent_stack_dir }}/secrets/openvpn_user
  openvpn_password:
    file: {{ qbittorrent_stack_dir }}/secrets/openvpn_password
  openvpn_clientcrt:
    file: {{ qbittorrent_stack_dir }}/secrets/openvpn_clientcrt
  openvpn_clientkey:
    file: {{ qbittorrent_stack_dir }}/secrets/openvpn_clientkey
