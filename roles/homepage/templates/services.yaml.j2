---
# {{ ansible_managed }}
- Multimédia:
    - Jellyfin:
        href: https://bibliofilm.alexandre-gerault.fr
        icon: jellyfin.png
        description: Streaming de films, séries et musiques
        container: jellyfin
        widget:
            type: jellyfin
            url: https://bibliofilm.alexandre-gerault.fr
            key: {{ vault_homepage_jellyfin_api_key }}
    - Jellyseerr:
        href: https://{{ arr_jellyseerr_domain }}
        icon: jellyseerr.png
        description: Demander un film ou une série
        container: jellyseerr

# Les widgets appellent les conteneurs par leur nom sur le réseau media : passer
# par les vhosts publics ferait répondre le SSO à la place de l'API.
- Téléchargement:
    - qBittorrent:
        href: https://{{ qbittorrent_webui_domain }}
        icon: qbittorrent.png
        description: Client torrent, derrière le VPN
        container: qbittorrent
        widget:
            type: qbittorrent
            url: http://gluetun:8080
            username: {{ qbittorrent_webui_username }}
            password: {{ vault_qbittorrent_webui_password }}
    - Prowlarr:
        href: https://{{ arr_prowlarr_domain }}
        icon: prowlarr.png
        description: Indexeurs, synchronisés vers Sonarr et Radarr
        container: prowlarr
        widget:
            type: prowlarr
            url: http://prowlarr:9696
            key: {{ vault_prowlarr_api_key }}
    - Sonarr:
        href: https://{{ arr_sonarr_domain }}
        icon: sonarr.png
        description: Séries et animes
        container: sonarr
        widget:
            type: sonarr
            url: http://sonarr:8989
            key: {{ vault_sonarr_api_key }}
    - Radarr:
        href: https://{{ arr_radarr_domain }}
        icon: radarr.png
        description: Films
        container: radarr
        widget:
            type: radarr
            url: http://radarr:7878
            key: {{ vault_radarr_api_key }}
    - Bazarr:
        href: https://{{ arr_bazarr_domain }}
        icon: bazarr.png
        description: Sous-titres
        container: bazarr
        widget:
            type: bazarr
            url: http://bazarr:6767
            key: {{ vault_bazarr_api_key }}

# Pas de widget ici : ceux d'Uptime Kuma, de Forgejo et de Keycloak demandent un
# jeton ou une page de statut qui n'existent pas encore.
- Productivité:
    - AFFiNE:
        href: {{ affine_external_url }}
        icon: affine.png
        description: Notes, documents et tableaux blancs
        container: affine_server
    - Penpot:
        href: https://penpot.alexandre-gerault.fr
        icon: penpot.png
        description: Design et prototypage
        container: penpot-penpot-frontend-1
    - Excalidraw:
        href: https://excalidraw.alexandre-gerault.fr
        icon: excalidraw.png
        description: Schémas dessinés à la main
    - Scholarsome:
        href: https://scholarsome.alexandre-gerault.fr
        icon: mdi-cards-outline
        description: Fiches de révision
        container: scholarsome-scholarsome-1

- Applications:
    - Jobiflow:
        href: https://{{ job_applications_domain }}
        icon: mdi-briefcase-search
        description: Suivi des candidatures de stage
        container: job-applications
    - ArbitrageFFV:
        href: {{ arbitrage_ffv_url }}
        icon: mdi-sail-boat
        description: Application de gestion des inspections de bateaux
        container: arbitrage_ffv_app

- Infrastructure:
    - Forgejo:
        href: https://{{ forgejo_domain }}
        icon: forgejo.png
        description: Forge git et registre de conteneurs
        container: forgejo
    - Forgejo Runner:
        icon: forgejo.png
        description: Exécuteur des Forgejo Actions
        container: forgejo-runner
    - Keycloak:
        href: https://{{ keycloak_domain }}/admin/{{ keycloak_realm }}/console/
        icon: keycloak.png
        description: Authentification unique (SSO)
        container: keycloak
    - Uptime Kuma:
        href: https://monitor.alexandre-gerault.fr
        icon: uptime-kuma.png
        description: Surveillance des services
        container: uptime-kuma-uptime-kuma-1
