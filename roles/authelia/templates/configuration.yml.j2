# {{ ansible_managed }}
#
# Secrets are not in this file. They are mounted as individual files under
# /secrets and read through the AUTHELIA_*_FILE environment variables.
---
theme: auto

server:
  address: 'tcp://0.0.0.0:9091'

log:
  level: {{ authelia_log_level }}
  format: text

totp:
  issuer: {{ authelia_root_domain }}

authentication_backend:
  password_reset:
    disable: false
  file:
    path: /config/users_database.yml
    watch: false
    password:
      algorithm: argon2
      argon2:
        variant: argon2id

access_control:
  default_policy: deny
  rules:
{% for rule in authelia_access_rules %}
    - domain: '{{ rule.domain }}'
      policy: {{ rule.policy }}
{% if rule.subject is defined %}
      subject: {{ rule.subject }}
{% endif %}
{% endfor %}

session:
  name: authelia_session
  expiration: 1h
  inactivity: 15m
  remember_me: 1M
  cookies:
    - domain: '{{ authelia_root_domain }}'
      authelia_url: 'https://{{ authelia_domain }}'
      default_redirection_url: '{{ authelia_default_redirect }}'

regulation:
  max_retries: 3
  find_time: 2m
  ban_time: 5m

storage:
  local:
    path: /data/db.sqlite3

{% if smtp_host | length > 0 %}
# The password comes from AUTHELIA_NOTIFIER_SMTP_PASSWORD_FILE. submissions://
# is TLS from the first byte (465), submission:// is STARTTLS (587).
notifier:
  disable_startup_check: {{ (not (authelia_smtp_startup_check | bool)) | lower }}
  smtp:
    address: '{{ 'submissions' if smtp_port | int == 465 else 'submission' }}://{{ smtp_host }}:{{ smtp_port }}'
    username: '{{ smtp_username }}'
    sender: '{{ smtp_sender }}'
    identifier: '{{ authelia_domain }}'
    subject: '[Authelia] {title}'
    tls:
      server_name: '{{ smtp_host }}'
      minimum_version: 'TLS1.2'
{% else %}
notifier:
  disable_startup_check: false
  filesystem:
    filename: /data/notification.txt
{% endif %}
{% if authelia_oidc_clients | length > 0 %}

# Authelia as an OpenID Connect provider. This is how an application that is not
# a browser-only web interface is put behind the SSO: Caddy's forward_auth would
# bounce its API calls and its git transport, so the application delegates its
# own login page here instead and keeps its own tokens for everything else.
identity_providers:
  oidc:
    # The RSA private key ID tokens are signed with. jwks is a list of objects,
    # and Authelia cannot read list members from environment variables, so this
    # is the one secret that has to come through the config file — mounted as a
    # file and pulled in by the template filter, never written in here.
    jwks:
      - key: {% raw %}{{ secret "/secrets/OIDC_JWK" | mindent 10 "|" | msquote }}{% endraw %}

    clients:
{% for client in authelia_oidc_clients %}
      - client_id: '{{ client.id }}'
        client_name: '{{ client.name }}'
        # A pbkdf2 digest, not the secret: the client holds the clear value.
        client_secret: '{{ client.secret_digest }}'
        public: false
        authorization_policy: '{{ client.policy | default('one_factor') }}'
        require_pkce: true
        pkce_challenge_method: 'S256'
        redirect_uris:
{% for uri in client.redirect_uris %}
          - '{{ uri }}'
{% endfor %}
        scopes:
{% for scope in client.scopes | default(['openid', 'email', 'profile', 'groups']) %}
          - '{{ scope }}'
{% endfor %}
        response_types:
          - 'code'
        grant_types:
          - 'authorization_code'
        # Unsigned access tokens and userinfo responses: the clients here read
        # the claims straight out of the userinfo endpoint over TLS and do not
        # implement JWT-signed variants.
        access_token_signed_response_alg: 'none'
        userinfo_signed_response_alg: 'none'
        token_endpoint_auth_method: 'client_secret_basic'
{% endfor %}
{% endif %}
