# {{ ansible_managed }}
#
# Secrets are not in this file. They are mounted as individual files under
# /secrets and read through the AUTHELIA_*_FILE environment variables.
---
theme: auto

server:
  address: 'tcp://0.0.0.0:9091'

log:
  level: {{ authelia_log_level }}
  format: text

totp:
  issuer: {{ authelia_root_domain }}

authentication_backend:
  password_reset:
    disable: false
  file:
    path: /config/users_database.yml
    watch: false
    password:
      algorithm: argon2
      argon2:
        variant: argon2id

access_control:
  default_policy: deny
  rules:
{% for rule in authelia_access_rules %}
    - domain: '{{ rule.domain }}'
      policy: {{ rule.policy }}
{% if rule.subject is defined %}
      subject: {{ rule.subject }}
{% endif %}
{% endfor %}

session:
  name: authelia_session
  expiration: 1h
  inactivity: 15m
  remember_me: 1M
  cookies:
    - domain: '{{ authelia_root_domain }}'
      authelia_url: 'https://{{ authelia_domain }}'
      default_redirection_url: '{{ authelia_default_redirect }}'

regulation:
  max_retries: 3
  find_time: 2m
  ban_time: 5m

storage:
  local:
    path: /data/db.sqlite3

notifier:
  disable_startup_check: false
  filesystem:
    filename: /data/notification.txt
