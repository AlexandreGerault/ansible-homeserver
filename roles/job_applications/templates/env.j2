# {{ ansible_managed }}
#
# Holds the app key, the client secret and the SMTP password: mode 0600, root.
# Every key is documented in the repository's .env.production.example.

APP_NAME={{ job_applications_app_name | to_json }}
APP_ENV=production
APP_KEY={{ vault_job_applications_app_key }}
APP_DEBUG=false
APP_URL=https://{{ job_applications_domain }}
APP_LOCALE={{ job_applications_locale }}
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE={{ common_timezone }}
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Caddy runs on the host: requests reach the container from the docker bridge.
TRUSTED_PROXIES={{ docker_address_pool }}

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/data/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

{% if smtp_host | length > 0 %}
# The shared mailbox, like Keycloak, Forgejo and AFFiNE. smtps is TLS from the
# first byte (465); smtp upgrades with STARTTLS on 587.
MAIL_MAILER=smtp
MAIL_SCHEME={{ 'smtps' if smtp_port | int == 465 else 'smtp' }}
MAIL_HOST={{ smtp_host }}
MAIL_PORT={{ smtp_port }}
MAIL_USERNAME={{ smtp_username }}
MAIL_PASSWORD={{ vault_smtp_password | to_json }}
MAIL_FROM_ADDRESS={{ (smtp_sender | regex_search('<(.+)>', '\\1') | first) if '<' in smtp_sender else smtp_sender }}
MAIL_FROM_NAME={{ job_applications_app_name | to_json }}
{% else %}
MAIL_MAILER=log
{% endif %}

JOB_APPLICATIONS_FOLLOW_UP_AFTER_DAYS={{ job_applications_follow_up_after_days }}
JOB_APPLICATIONS_EXPIRE_AFTER_DAYS={{ job_applications_expire_after_days }}

OIDC_ISSUER=https://{{ keycloak_domain }}/realms/{{ keycloak_realm }}
OIDC_CLIENT_ID={{ job_applications_oidc_client_id }}
OIDC_CLIENT_SECRET={{ vault_job_applications_oidc_client_secret }}
OIDC_DISPLAY_NAME={{ job_applications_oidc_display_name }}
OIDC_SCOPES="openid profile email"
OIDC_AUTO_REGISTER=true
OIDC_LINK_BY_EMAIL=true
OIDC_LOGOUT_FROM_PROVIDER=true

AUTORUN_ENABLED=true
PHP_DATE_TIMEZONE={{ common_timezone }}
