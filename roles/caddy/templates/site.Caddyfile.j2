# {{ ansible_managed }}
{{ site.domain }} {
{% if site.log | default(false) %}
    log {
        output file {{ caddy_log_file }} {
            roll_size 10MB
            roll_keep 5
            roll_keep_days 14
        }
    }
{% endif %}
{% if site.protect | default(false) %}
    forward_auth {{ caddy_authelia_upstream }} {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
    }
{% endif %}
    reverse_proxy :{{ site.upstream_port }}
}
